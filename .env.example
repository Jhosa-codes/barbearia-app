# MCP - Figma (direto)
# Cole aqui o seu Personal Access Token do Figma (Settings → Personal access tokens)
FIGMA_ACCESS_TOKEN=seu_token_aqui

# MCP - Composio (Figma via Composio)
# Cole aqui a sua Consumer API Key da Composio (connect.composio.dev)
COMPOSIO_API_KEY=ck_...

# MCP - Composio (endpoint)
COMPOSIO_MCP_URL=https://connect.composio.dev/mcp
